        "--seed",
        "42",
        "--level",
        "0",
        "--screenshot",
        "build/captures/forest.ppm",
        "--state",
        "build/captures/forest.json"
      ],
      "stdout": "OpenGL renderer: llvmpipe (LLVM 20.1.2, 256 bits)\nRendered 240 frames; scene 0, lives 1, collisions 4\n",
      "final_state": {
        "level": 0,
        "lives": 1,
        "player_x": -2.99999,
        "player_y": -2.4,
        "collisions": 4,
        "frames": 240
      }
    },
    {
      "image": "docs/images/city.webp",
